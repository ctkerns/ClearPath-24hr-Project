# ":80" serves plain HTTP. For a real domain, replace ":80" with the domain name
# and Caddy gets an HTTPS certificate automatically.
:80 {
	encode zstd gzip

	# API requests go to the FastAPI service. Same origin as the app, so session cookies need no CORS setup.
	# "handle" blocks are exclusive: a request runs only the first block that matches,
	# so try_files below never rewrites /api/* to index.html.
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# Single-page app: unknown paths like /materials/123 return index.html,
		# and TanStack Router selects the page in the browser.
		try_files {path} /index.html
		file_server

		# Vite puts a content hash in asset file names, so browsers can cache them permanently
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Everything else (index.html for every page URL) must always be fresh,
		# so users get the newest asset names after a deploy.
		# Caddy runs "header" before "try_files", so match the original path, not /index.html.
		@not_assets not path /assets/*
		header @not_assets Cache-Control "no-cache"
	}
}
